{
  "name": "neutrino-browser",
  "version": "0.2.0",
  "description": "Local-first, high-speed Chromium desktop browser with Brave-level ad-blocking, Zen-level low resource usage, Arc-level customizability, and native MCP capability.",
  "main": "dist-main/index.js",
  "scripts": {
    "build:main": "tsc -p tsconfig.main.json && node -e \"const fs=require('fs'); fs.copyFileSync('node_modules/darkreader/darkreader.js', 'dist-main/darkreader.js');\"",
    "build:renderer": "vite build",
    "build": "npm run build:renderer && npm run build:main",
    "start": "npm run build && (set ELECTRON_RUN_AS_NODE=& electron .)",
    "start:packaged": "cmd /c \"set ELECTRON_RUN_AS_NODE=& release\\Neutrino-win32-x64\\Neutrino.exe\"",
    "package": "npm run build && electron-packager . Neutrino --platform=win32 --arch=x64 --out=release --overwrite --prune=true --icon=assets/icon.ico"
  },
  "dependencies": {
    "anthropic-fonts": "^1.1.0",
    "darkreader": "^4.9.135",
    "lucide-react": "^1.16.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/node": "^22.13.0",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "^33.2.0",
    "electron-packager": "^17.1.2",
    "typescript": "^5.7.3",
    "vite": "^6.1.0"
  }
}
