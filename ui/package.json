{
  "name": "neutrino-ui",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "start": "electron .",
    "package:win": "electron-packager . Neutrino --platform=win32 --arch=x64 --out=../dist --overwrite --prune=true"
  },
  "dependencies": {
    "lucide-react": "^1.16.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/node": "^22.13.0",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "^45.1.0",
    "electron-packager": "^17.1.2",
    "typescript": "^5.7.3",
    "vite": "^6.1.0"
  }
}
