# ==============================================================================
# Neutrino Browser - Git Ignore (Root)
# Covers both electron/ and rust/ (Tauri) workspaces
# ==============================================================================

# Node / Electron / Web Frontend
**/node_modules/
**/dist/
**/dist-*/
**/dist-renderer/
**/dist-main/
**/release/
**/out/
**/.vite/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Rust / Cargo / Tauri
**/target/
**/*.rs.bk
**/Cargo.lock
rust/src-tauri/target/
native/target/
electron/native/target/

# Python & Cache
**/__pycache__/
*.py[cod]
.venv/
venv/
env/

# OS & Temp
Thumbs.db
[Dd]esktop.ini
.DS_Store
*.tmp
*.temp
scratch/
electron/scratch/
rust/scratch/
**/tests/*.png

# Toolchain bin wrappers
rust/src-tauri/.tools/*.exe
rust/src-tauri/.tools/*.dll

